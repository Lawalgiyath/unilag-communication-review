# Database (SQLite file path, relative to project root)
DATABASE_URL="file:../data/journal.db"

# Absolute public URL of the site (no trailing slash) — used for citation_pdf_url,
# sitemap, RSS, OAI-PMH and emails. MUST be set correctly in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Directory for uploaded files (manuscripts + published PDFs).
# Relative paths resolve from the project root.
UPLOADS_DIR="./uploads"

# SMTP (optional — if unset, emails are logged to the console and EmailLog table)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="UNILAG Communication Review <no-reply@unilagcommunicationreview.ng>"
